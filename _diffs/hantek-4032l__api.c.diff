+static int local_std_str_idx(GVariant *data, const char *const strs[], size_t count)
+{
+	const char *str;
+	size_t i;
+
+	str = g_variant_get_string(data, NULL);
+	for (i = 0; i < count; i++) {
+		if (strcmp(str, strs[i]) == 0)
+			return (int)i;
+	}
+	return -1;
+}
