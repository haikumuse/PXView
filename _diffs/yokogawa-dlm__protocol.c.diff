+/*
+ * Local replacements for standard sigrok's sr_atof_ascii / sr_atoi which are
+ * not provided by PXView's libsigrok. These parse ASCII numeric strings in a
+ * locale-independent way and return SR_OK/SR_ERR.
+ */
+static int local_sr_atof_ascii(const char *str, float *ret)
+{
+	char *e;
+	double tmp;
+
+	errno = 0;
+	tmp = g_ascii_strtod(str, &e);
+	if (e == str || errno != 0)
+		return SR_ERR;
+	*ret = (float)tmp;
+	return SR_OK;
+}
+
+static int local_sr_atoi(const char *str, int *ret)
+{
+	char *e;
+	long tmp;
+
+	errno = 0;
+	tmp = strtol(str, &e, 10);
+	if (e == str || *e != '\0' || errno != 0)
+		return SR_ERR;
+	if (tmp > INT_MAX || tmp < INT_MIN)
+		return SR_ERR;
+	*ret = (int)tmp;
+	return SR_OK;
+}
+
+/*
+ * Local helper to format a timebase (given as a numerator/denominator pair of
+ * seconds) into a human-readable period string. Standard sigrok's
+ * sr_period_string() takes a (p, q) pair, but PXView's sr_period_string()
+ * takes a single frequency value. We instead compute the period in nanoseconds
+ * and delegate to PXView's sr_time_string().
+ */
+static char *dlm_period_string(uint64_t p, uint64_t q)
+{
+	uint64_t period_ns;
+
+	if (q == 0)
+		return g_strdup("? s");
+
+	/* period = p/q seconds = p*1e9/q nanoseconds.
+	 * The DLM timebase table uses values that keep this exact. */
+	period_ns = (uint64_t)((double)p * 1e9 / (double)q);
+	return sr_time_string(period_ns);
+}
