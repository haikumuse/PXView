+/*
+ * Local replacement for standard sigrok's sr_atoi(), which is not provided
+ * by PXView's compat layer. Parses str as a base-10 integer into out.
+ * Returns SR_OK on success, SR_ERR on parse failure.
+ */
+static int ut181a_atoi(const char *str, int *out)
+{
+	char *end;
+	long val;
+
+	if (!str || !out)
+		return SR_ERR_ARG;
+
+	errno = 0;
+	val = strtol(str, &end, 10);
+	if (errno != 0 || end == str || *end != '\0')
+		return SR_ERR;
+
+	*out = (int)val;
+	return SR_OK;
+}
