+/*
+ * Helper: find the index of a GVariant string in a string array.
+ * Replaces standard sigrok's 3-arg std_str_idx(data, strs, count) which
+ * is not provided by PXView's compat layer (the compat std_str_idx has a
+ * different signature/semantics).
+ */
+static int mso_str_idx(GVariant *data, const char *const strs[], size_t count)
+{
+	const char *s;
+	size_t i;
+
+	if (!data || !strs || count == 0)
+		return -1;
+
+	s = g_variant_get_string(data, NULL);
+	if (!s)
+		return -1;
+
+	for (i = 0; i < count; i++) {
+		if (g_strcmp0(s, strs[i]) == 0)
+			return (int)i;
+	}
+
+	return -1;
+}
